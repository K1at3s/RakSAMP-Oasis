        "count": 20,
        "accepted": 16
      },
      {
        "type": "expect_http_count",
        "prefix": "GET /read\n",
        "count": 1
      },
      {
        "type": "pump"
      },
      {
        "type": "expect",
        "read_callbacks": 16
      }
    ]
  },
