[
  {
    "name": "cold-welcome-list-completes-once",
    "events": [
      {
        "type": "setup"
      },
      {
        "type": "backend_async"
      },
      {
        "type": "backend_response",
        "request": "GET /api/welcome/peruser/list?hwid=replay-hwid",
        "body": {
          "success": true,
          "list": [
            {
              "target_name": "Ali",
              "custom_message": "Welcome"
            }
          ]
        }
      },
      {
        "type": "command",
        "text": "?welcomemsg list"
      },
      {
        "type": "pump"
      },
      {
        "type": "expect_chat_contains",
        "text": "Ali->Welcome"
      },
      {
        "type": "expect_http_count",
        "prefix": "GET /api/welcome/peruser/list",
        "count": 1
      }
    ]
  },
