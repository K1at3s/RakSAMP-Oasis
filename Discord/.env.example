# Required runtime secrets
DISCORD_BOT_TOKEN=
# Generate a random value with at least 32 characters. Changing it invalidates active client sessions.
RAKSAMP_AES_SECRET=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=raksamp
MYSQL_PASSWORD=
MYSQL_DB=raksamp_oasis
PORT=3001
# Optional browser origins, comma-separated; leave empty when only the native client connects.
RAKSAMP_CORS_ORIGINS=
# Optional Google Sheets integration
GS_SERVICE_ACCOUNT_FILE=
GS_SPREADSHEET_ID=
GS_OWNER_EMAIL=
